<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.csproject</groupId>
    <artifactId>csproject</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jme3_g>org.jmonkeyengine</jme3_g>
        <jme3_v>3.3.0-stable</jme3_v>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.5.2</version>
        </dependency> 
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.12.0</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>1.4.200</version>
            <scope>runtime</scope>
        </dependency>
        
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.12</version>
            <!-- <scope>test</scope> -->
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-core</artifactId>
            <version>1.3</version>
            <!-- <scope>test</scope> -->
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.9.3</version>
            <!-- <scope>test</scope> -->
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.15</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/org.jmonkeyengine/jme3-core -->
        <!-- <dependency>
            <groupId>org.jmonkeyengine</groupId>
            <artifactId>jme3-core</artifactId>
            <version>3.7.0-stable</version>
        </dependency> -->

        <!--任何jME3项目都需要的核心类库-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-core</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--包含jME3桌面应用开发的部分 API ，只兼容jME3的桌面渲染器，主要用于导入图片-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-desktop</artifactId>
            <version>${jme3_v}</version>
            <scope>runtime</scope>
        </dependency>

        <!--基于LWJGL的jME3桌面渲染器-->
        <!--<dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-lwjgl</artifactId>
            <version>${jme3_v}</version>
        </dependency>-->

        <!--jME3.1新增类库。基于LWJGL3的jME桌面渲染器。 (beta)-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-lwjgl3</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--包含水面、雾效等后处理特效(post process effects)的类库-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-effects</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--Blender文件导入插件，只能和jME3的桌面版渲染器(jme3-desktop)一起使用-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-blender</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--用于加载orge、fbx、gltf等3D模型的插件类库-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-plugins</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--用于加载OGG音频文件的插件类库-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-jogg</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--为jME3添加NiftyGUI支持，可用来制作图形用户界面。(JCenter仓库中没有这个类库)-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-niftygui</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--基于高度图的地形生成 API-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-terrain</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--jME3的网络类库(别名SpiderMonkey)-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-networking</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--Physics support using jbullet (仅用于开发桌面应用，JCenter仓库中没有这个类库) jme3-jbullet 或 jme3-bullet 只能选一个，不能同时存在-->
        <!--<dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-jbullet</artifactId>
            <version>${jme3_v}</version>
        </dependency>-->

        <!--基于Bullet Physics 实现的物理引擎，需要 jme3-bullet-native 或 jme3-bullet-native-android 。 (beta)-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-bullet</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--jme3-bullet(不是jbullet)所需的本地库文件(.dll, .so)，适用于桌面开发。 (beta)-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-bullet-native</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--jme3-bullet(不是jbullet)所需的本地库文件(.dll, .so)，适用于Android开发。 (beta)-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-bullet-native-android</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--基于JOGL的jME3桌面渲染器。(可选替换 lwjgl / lwjgl3)-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-jogl</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--jME3的Android版渲染器-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-android</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--Android开发jME3应用所需的本地库文件(.dll, .so)-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-android-native</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--jME3的iOS版渲染器。(JCenter仓库中没有这个类库)-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-ios</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--jME3.2 新增类库，可支持虚拟现实(VR)开发。(JCenter仓库中没有这个类库)-->
        <dependency>
            <groupId>${jme3_g}</groupId>
            <artifactId>jme3-vr</artifactId>
            <version>${jme3_v}</version>
        </dependency>

        <!--
        使用jME3开发桌面应用，至少需要以下依赖包：
        jme3-core
        jme3-desktop
        jme3-lwjgl 或 jme3-lwjgl3

        使用jME3开发Android应用，至少以下依赖包：
        jme3-core
        jme3-android
        jme3-android-native
        -->
        
    </dependencies>
    

</project>